# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://mesakh-portfolio.vercel.app

# Resend (https://resend.com) — required for the CV request to send email.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "Mesakh <cv@yourdomain.com>".
CV_REQUEST_FROM_EMAIL=
# Where request notifications go (your own inbox).
CV_NOTIFICATION_EMAIL=admesakh@gmail.com

# Where the CV PDF is read from, server-side only. Use ONE of:
# 1) A private, unguessable URL the server can fetch (e.g. a private Vercel Blob URL).
CV_FILE_URL=
# 2) Or leave empty and place the file at ./private/cv.pdf (only if the repo is private).
CV_FILE_NAME=Mesakh-CV.pdf
